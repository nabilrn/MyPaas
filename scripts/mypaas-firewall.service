[Unit]
Description=MyPaaS managed firewall helper
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/mypaas/firewall-helper.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=mypaas
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=MYPAAS_FIREWALL_SOCKET=/run/mypaas/firewall.sock
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
